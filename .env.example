# Copy this file to ".env" (same folder) and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
# The .env file stays on your computer; the course app never sends it to the browser.

GEMINI_API_KEY=paste-your-key-here

# Which Gemini model the tutor uses. gemini-3.8-flash is Google's current recommended
# general model; gemini-3.5-flash-lite is cheaper and faster but less careful.
GEMINI_MODEL=gemini-3.8-flash

# ---- Sign in with Google (optional) ----
# Leave these empty to keep progress on this computer with no sign-in.
# Fill them in to give everyone their own account. README.md explains where they come from.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address people open. Locally that's http://localhost:8765; on a web host, its https address.
PUBLIC_URL=http://localhost:8765
# Your Google email: the first time you sign in, you get the progress saved before sign-in existed.
OWNER_EMAIL=
# Who may sign in, comma separated. Empty means any Google account.
ALLOWED_EMAILS=
# AI tutor requests per person per day (your Gemini key pays for everyone's). 0 means no limit.
TUTOR_DAILY_LIMIT=100
